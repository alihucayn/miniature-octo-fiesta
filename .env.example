PORT=3000
# Must be the real public https origin (no trailing slash). Watermark links,
# upgrade links, the sitemap, recovery emails and hosted file URLs use it.
PUBLIC_URL=https://pdf.yourdomain.com
# Docker: must be under /data (the docforge-data volume) or every redeploy wipes the DB.
# For local `npm start` without Docker, delete this line (src/db.js defaults to ./data/docforge.db).
DB_PATH=/data/docforge.db
# Optional: where output:'url' PDFs are kept (default: dirname(DB_PATH)/files)
# FILES_DIR=/data/files
# Daily in-process SQLite snapshots (newest 7 kept); deploy/backup.sh ships them off-site
BACKUP_DIR=/data/backups
SUPPORT_EMAIL=support@yourdomain.com
# With NODE_ENV=production (the Docker image) the server refuses to start while
# public/guides/{terms,privacy,refunds}.html still contain [TODO] placeholders.
# Set to 1 only for a private staging run.
# ALLOW_DRAFT_LEGAL=1
# Only set behind a reverse proxy such as Caddy (deploy/Caddyfile); default false
TRUST_PROXY=1

# Rendering limits
RENDER_CONCURRENCY=2
RENDER_MAX_QUEUE=50
RENDER_DEADLINE_MS=30000
# Optional: path to a Chromium binary if not using the bundled Playwright one
# CHROMIUM_PATH=/usr/bin/chromium

# Transactional email (key recovery). Without both values, mails are only logged.
RESEND_API_KEY=
MAIL_FROM=

# Lemon Squeezy: Merchant of record. Verify payouts for your country before launch
# (PayPal cannot receive in Pakistan); see docs/launch-checklist.md
LS_WEBHOOK_SECRET=
LS_VARIANT_STARTER=
LS_VARIANT_PRO=
LS_VARIANT_BUSINESS=
LS_VARIANT_STARTER_YEARLY=
LS_VARIANT_PRO_YEARLY=
LS_VARIANT_BUSINESS_YEARLY=
# Checkout links, e.g. https://yourstore.lemonsqueezy.com/buy/<variant-uuid>
# Leave empty until the store is approved; the landing page then shows 'Paid plans open soon'.
LS_CHECKOUT_STARTER=
LS_CHECKOUT_PRO=
LS_CHECKOUT_BUSINESS=
