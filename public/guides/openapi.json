  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your API key, e.g. Authorization: Bearer df_live_..."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "unauthorized": {
                "value": {
                  "error": "unauthorized",
                  "message": "..."
                }
              }
            }
          }
        }
      },
      "Suspended": {
        "description": "account_suspended",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "account_suspended": {
                "value": {
                  "error": "account_suspended",
                  "message": "..."
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable machine-readable code"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ServerError": {
        "type": "object",
        "properties": {
          "error": {
            "const": "render_failed"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "UpgradeUrls": {
        "type": "object",
        "description": "Checkout links for configured plans above the current one",
        "properties": {
          "starter": {
            "type": "string",
            "format": "uri"
          },
          "pro": {
            "type": "string",
            "format": "uri"
          },
          "business": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Upsell": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "quota_exceeded",
              "template_limit"
            ]
          },
          "message": {
            "type": "string"
          },
          "upgrade_url": {
            "type": "string",
            "format": "uri",
            "description": "<PUBLIC_URL>/#pricing"
          },
          "upgrade_urls": {
            "$ref": "#/components/schemas/UpgradeUrls"
          }
        }
      },
      "Plan": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "priceUsd": {
            "type": "number"
          },
          "monthlyRenders": {
            "type": "integer"
          },
          "templates": {
            "type": "integer"
          },
          "watermark": {
            "type": "boolean"
          },
          "graceRenders": {
            "type": "integer"
          },
          "concurrency": {
            "type": "integer"
          },
          "maxPages": {
            "type": "integer"
          }
        }
      },
      "Margin": {
        "oneOf": [
          {
            "type": "string",
            "example": "12mm"
          },
          {
            "type": "object",
            "properties": {
              "top": {
                "type": "string"
              },
              "right": {
                "type": "string"
              },
              "bottom": {
                "type": "string"
              },
              "left": {
                "type": "string"
              }
            }
          }
        ]
      },
      "RenderOptions": {
        "type": "object",
        "description": "Merged over the template defaults. Without margin, 14mm/12mm/16mm/12mm is used; header_html/footer_html force at least 15mm.",
        "properties": {
          "format": {
            "type": "string",
            "description": "Case-insensitive",
            "enum": [
              "a4",
              "letter",
              "legal",
              "a5",
              "a3",
              "tabloid",
              "ledger"
            ]
          },
          "width": {
            "type": [
              "string",
              "number"
            ],
            "example": "210mm",
            "description": "px number or a string in px, in, cm or mm"
          },
          "height": {
            "type": [
              "string",
              "number"
            ],
            "example": "297mm"
          },
          "landscape": {
            "type": "boolean"
          },
          "margin": {
            "$ref": "#/components/schemas/Margin"
          },
          "preferCSSPageSize": {
            "type": "boolean"
          },
          "printBackground": {
            "type": "boolean"
          },
          "header_html": {
            "type": "string",
            "description": "Chromium header template; use <span class=\"pageNumber\"></span> and <span class=\"totalPages\"></span>"
          },
          "footer_html": {
            "type": "string"
          }
        }
      },
      "RenderRequest": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string",
            "description": "Stored template id or gallery:<name>"
          },
          "html": {
            "type": "string",
            "description": "Inline Handlebars/HTML (max 512KB with css)"
          },
          "css": {
            "type": "string"
          },
          "data": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "string",
                "description": "JSON-encoded object"
              }
            ]
          },
          "raw": {
            "type": "boolean",
            "default": false,
            "description": "Inline html only: skip Handlebars and render the HTML as sent"
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "https only; resolves relative asset URLs"
          },
          "filename": {
            "type": "string",
            "default": "document.pdf"
          },
          "output": {
            "type": "string",
            "enum": [
              "binary",
              "base64",
              "url"
            ],
            "default": "binary"
          },
          "options": {
            "$ref": "#/components/schemas/RenderOptions"
          }
        }
      },
      "Base64Output": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "content_type": {
            "const": "application/pdf"
          },
          "size": {
            "type": "integer"
          },
          "base64": {
            "type": "string"
          },
          "warnings": {
            "$ref": "#/components/schemas/Warnings"
          }
        }
      },
      "UrlOutput": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "<PUBLIC_URL>/f/<32-char token>/<filename>; public, valid 24 hours"
          },
          "filename": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_type": {
            "const": "application/pdf"
          },
          "warnings": {
            "$ref": "#/components/schemas/Warnings"
          }
        }
      },
      "Warnings": {
        "type": "object",
        "properties": {
          "blocked_assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TemplateInput": {
        "type": "object",
        "required": [
          "name",
          "html"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "html": {
            "type": "string"
          },
          "css": {
            "type": "string"
          },
          "sample_data": {
            "type": "object"
          }
        }
      },
      "Template": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "tpl_abc123"
          },
          "name": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "css": {
            "type": "string"
          },
          "sample_data": {
            "type": "object"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "GallerySummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "gallery:invoice"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sample_data": {
            "type": "object"
          },
          "options": {
            "$ref": "#/components/schemas/RenderOptions"
          }
        }
      },
      "GalleryTemplate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GallerySummary"
          },
          {
            "type": "object",
            "properties": {
              "html": {
                "type": "string"
              },
              "css": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "key_prefix": {
            "type": "string"
          },
          "month": {
            "type": "string",
            "example": "2026-10"
          },
          "renders_used": {
            "type": "integer"
          },
          "renders_limit": {
            "type": "integer"
          },
          "renders_grace": {
            "type": "integer"
          },
          "templates_used": {
            "type": "integer"
          },
          "templates_limit": {
            "type": "integer"
          },
          "upgrade_urls": {
            "$ref": "#/components/schemas/UpgradeUrls"
          }
        }
      }
    }
  }
}
